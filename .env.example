# Copy to .env (production build) and .env.dev (local dev), then fill in.
# NEVER commit the filled-in files - see .gitignore

# --- Supabase ---
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# --- External storage/mail service (storage.leenmore.com) ---
REACT_APP_STORAGE_PATH=
REACT_APP_STORAGE_AUTH_KEY=

# --- App config ---
REACT_APP_EN_VERSION=

# --- Scripts only (not bundled; no REACT_APP_ prefix) ---
PASSWORD_ONLY_FOR_RUN_CODES=
